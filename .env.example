# Copy to .env for docker compose (or set these in Portainer).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
POSTGRES_PASSWORD=change-me-too
# Public URL where players open the game (used in push notification links).
PUBLIC_URL=https://seatrader.example.com
# Extra browser origins allowed to call the API, e.g. the GitHub Pages site (comma separated).
CORS_ORIGINS=
# Optional: fixed VAPID keys for web push (npm run vapid). If empty they are generated and stored in the DB.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
