#!/usr/bin/env bash
# Waybar custom module for Sea Trader.
# Prints Waybar JSON ({text, tooltip, class}) and raises desktop notifications (mako) for new
# "action needed" events. Config: ~/.config/sea-trader/config (SEA_TRADER_API, SEA_TRADER_TOKEN).
set -uo pipefail

CONFIG="${SEA_TRADER_CONFIG:-$HOME/.config/sea-trader/config}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/sea-trader"
SEEN="$STATE_DIR/seen"
ICON="${SEA_TRADER_ICON:-⚓}"

out() { jq -cn --arg text "$1" --arg tooltip "$2" --arg class "$3" '{text: $text, tooltip: $tooltip, class: $class, alt: $class}'; }

if ! command -v jq >/dev/null || ! command -v curl >/dev/null; then
  echo '{"text":"⚓ !","tooltip":"sea-trader-status needs curl and jq","class":"offline"}'
  exit 0
fi
if [[ ! -r "$CONFIG" ]]; then
  out "$ICON ?" "Sea Trader is not configured.\nRun integrations/omarchy/install.sh" "offline"
  exit 0
fi
# shellcheck source=/dev/null
source "$CONFIG"

json=$(curl -fsS --max-time 10 -H "Authorization: Bearer ${SEA_TRADER_TOKEN:-}" "${SEA_TRADER_API%/}/status" 2>/dev/null) || {
  out "$ICON ×" "Sea Trader server unreachable\n${SEA_TRADER_API:-}" "offline"
  exit 0
}

count=$(jq -r '.count' <<<"$json")
urgent=$(jq -r '.urgent' <<<"$json")

# Desktop notifications for new action notices.
mkdir -p "$STATE_DIR"
if [[ ! -f "$SEEN" ]]; then
  jq -r '.notifications[].id' <<<"$json" >"$SEEN"
else
  while IFS=$'\t' read -r id text game; do
    [[ -z "$id" ]] && continue
    grep -qx "$id" "$SEEN" && continue
    echo "$id" >>"$SEEN"
    if command -v notify-send >/dev/null; then
      (
        action=$(notify-send -a "Sea Trader" -i "anchor" -u normal --action=open="Open game" "⚓ ${game}" "$text" 2>/dev/null)
        [[ "$action" == "open" ]] && "$(dirname "$(readlink -f "$0")")/sea-trader-open"
      ) &
    fi
  done < <(jq -r --argjson games "$(jq '[.games[] | {(.id): .name}] | add // {}' <<<"$json")" \
    '.notifications[] | select(.action) | [.id, .text, ($games[.gameId] // "Sea Trader")] | @tsv' <<<"$json")
  tail -n 500 "$SEEN" >"$SEEN.tmp" && mv "$SEEN.tmp" "$SEEN"
fi

tooltip=$(jq -r '
  if .count == 0 then "All ships are under way. Nothing to do."
  else ([.pending[] | "\(.game): \(.text)"] | join("\n")) end
  + "\n\n" + ([.games[] | "\(.name) — \(.date)\(if .status != "running" then " (\(.status))" else "" end)"] | join("\n"))
' <<<"$json")

if ((urgent > 0)); then
  out "$ICON $count" "$tooltip" "urgent"
elif ((count > 0)); then
  out "$ICON $count" "$tooltip" "pending"
else
  out "$ICON" "$tooltip" "idle"
fi
