#!/usr/bin/env bash
# Toggles Sea Trader as a floating window on a Hyprland special workspace ("scratchpad").
# First call launches the web app in its own Chromium profile; later calls show/hide it.
set -uo pipefail

CONFIG="${SEA_TRADER_CONFIG:-$HOME/.config/sea-trader/config}"
# shellcheck source=/dev/null
[[ -r "$CONFIG" ]] && source "$CONFIG"
URL="${1:-${SEA_TRADER_URL:-http://localhost:2567/}}"
WS="${SEA_TRADER_WORKSPACE:-seatrader}"
SIZE="${SEA_TRADER_SIZE:-1280 840}"
PROFILE="${SEA_TRADER_PROFILE:-$HOME/.local/share/sea-trader/browser}"

browser="${SEA_TRADER_BROWSER:-}"
if [[ -z "$browser" ]]; then
  for b in chromium google-chrome-stable google-chrome brave brave-browser; do
    command -v "$b" >/dev/null && browser="$b" && break
  done
fi

if ! command -v hyprctl >/dev/null; then
  if [[ -n "$browser" ]]; then exec "$browser" --app="$URL" --user-data-dir="$PROFILE"; else exec xdg-open "$URL"; fi
fi

running=$(hyprctl clients -j | jq --arg ws "special:$WS" '[.[] | select(.workspace.name == $ws)] | length')

if [[ "$running" -gt 0 ]]; then
  hyprctl dispatch togglespecialworkspace "$WS" >/dev/null
  exit 0
fi

if [[ -z "$browser" ]]; then
  notify-send "Sea Trader" "No Chromium-based browser found; opening in the default browser."
  exec xdg-open "$URL"
fi

mkdir -p "$PROFILE"
# A dedicated profile gives the window its own process, so Hyprland's exec rules apply to it.
hyprctl dispatch exec "[workspace special:$WS silent; float; size $SIZE; center] $browser --app=$URL --user-data-dir=$PROFILE --class=sea-trader --no-first-run --no-default-browser-check" >/dev/null
sleep 0.4
hyprctl dispatch togglespecialworkspace "$WS" >/dev/null
